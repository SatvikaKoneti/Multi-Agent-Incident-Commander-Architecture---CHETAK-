# ---- Server ----
PORT=4000
NODE_ENV=development
# Comma separated list of allowed CORS origins for the browser frontend
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Database ----
# The engine uses an embedded SQLite file by default.
# How to point to PostgreSQL:
#   1. Set DB_ENGINE=postgres
#   2. Set DATABASE_URL=postgres://user:pass@host:5432/hyd_urban_ai
#   3. Implement ./src/db/engine.js factory for the 'postgres' engine (see docs/ARCHITECTURE.md)
DB_ENGINE=sqlite
DATABASE_PATH=../data/hyd_urban_ai.sqlite
VECTOR_STORE_PATH=../data/vector_store.json

# ---- AI Configuration ----
# OPTION 1: Groq (100% FREE, ultra-fast LPU inference, no credit card required)
# 1. Sign up at https://console.groq.com/keys
# 2. Generate a key (gsk_...) and paste it:
GROQ_API_KEY=
# Default when GROQ_API_KEY is set: AI_MODEL=llama-3.3-70b-versatile, AI_BASE_URL=https://api.groq.com/openai/v1

# OPTION 2: xAI Grok (requires prepaid credits on console.x.ai)
GROK_API_KEY=
# AI_MODEL=grok-2-vision-1212
# AI_BASE_URL=https://api.x.ai/v1
AI_TEMPERATURE=0.4
AI_TIMEOUT_MS=120000
AI_MAX_TOKENS=3072

# Alternatively, to use OpenRouter:
# OPENROUTER_API_KEY=sk-or-v1-...
# AI_MODEL=x-ai/grok-2-1212   (or google/gemma-4-31b-it:free)
# AI_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=

# ---- Auth ----
JWT_SECRET=change-me-in-production-hyd-urban-ai
JWT_EXPIRES_IN=12h

# ---- Uploads ----
UPLOAD_DIR=../uploads
UPLOAD_MAX_IMAGE_MB=5
UPLOAD_MAX_VIDEO_MB=50

# ---- Frontend static (served by backend when built) ----
FRONTEND_DIST=../frontend/dist
